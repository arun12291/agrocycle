# AgroCycle Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =====================================================
# Database
# =====================================================
DB_URL=jdbc:mysql://localhost:3306/agrocycle_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=agrocycle_user
DB_PASSWORD=YourSecurePasswordHere

# =====================================================
# Email (SMTP) - set MAIL_ENABLED=true when configured
# =====================================================
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@agrocycle.com

# =====================================================
# File Upload
# =====================================================
UPLOAD_DIR=uploads

# =====================================================
# Delivery Settings
# =====================================================
DELIVERY_OFFER_TIMEOUT=30

# =====================================================
# Server
# =====================================================
SERVER_PORT=8080
